    {
      "parameters": {
        "jsCode": "// Build the UPSERT payload from Google Sheets human-edited data\n// Google Sheets row is the current input\nconst sheetsRow = $input.first().json;\n\n// CRITICAL FIX: Use .item.json to get the CURRENT row in the loop, NOT .first()\nconst supabaseRow = $('Loop Over Each Content Row').item.json;\n\n// Resolve carousel content:\n// If format is carousel, rebuild carousel_content from Slide columns\n// If not carousel, set to null\nlet carouselContent = null;\nif (supabaseRow.format === 'carousel') {\n  carouselContent = {\n    slide_1: sheetsRow['Slide 1'] || supabaseRow.carousel_content?.slide_1 || '',\n    slide_2: sheetsRow['Slide 2'] || supabaseRow.carousel_content?.slide_2 || '',\n    slide_3: sheetsRow['Slide 3'] || supabaseRow.carousel_content?.slide_3 || '',\n    slide_4: sheetsRow['Slide 4'] || supabaseRow.carousel_content?.slide_4 || '',\n    slide_5: sheetsRow['Slide 5'] || supabaseRow.carousel_content?.slide_5 || '',\n    slide_6: sheetsRow['Slide 6'] || supabaseRow.carousel_content?.slide_6 || '',\n    slide_7: sheetsRow['Slide 7'] || supabaseRow.carousel_content?.slide_7 || ''\n  };\n}\n\nreturn [{\n  json: {\n    // IDs for filtering\n    id: supabaseRow.id,\n    client_id: supabaseRow.client_id,\n    day_number: supabaseRow.day_number,\n    \n    // Human-edited fields from Sheets (override AI drafts)\n    post_copy: sheetsRow['Post Copy'] || supabaseRow.post_copy,\n    hashtags: sheetsRow['Hashtags'] || supabaseRow.hashtags,\n    carousel_content: carouselContent,\n    \n    // Explicitly update the status\n    status: 'Manager_Approved',\n    \n    // Marketer attribution\n    author: sheetsRow['Done By'] || 'Manager',\n    \n    // Timestamps\n    updated_at: new Date().toISOString(),\n    approved_at: new Date().toISOString(),\n    \n    // Keep existing fields untouched\n    image_url: supabaseRow.image_url,\n    drive_folder_url: supabaseRow.drive_folder_url,\n    posting_date: supabaseRow.posting_date,\n    hook:     sheetsRow['Hook']     || supabaseRow.hook,\n    alt_text: sheetsRow['Alt Text'] || supabaseRow.alt_text,\n  }\n}];"
      },
