    {
      "parameters": {
        "jsCode": "// Safely extract content from Gemini, OpenAI, or LangChain responses\nconst content = $json.text ?? $json.output ?? $json.candidates?.[0]?.content?.parts?.[0]?.text ?? $json.message?.content ?? $json.choices?.[0]?.message?.content ?? '';\n\nlet parsed = [];\ntry {\n  // Strip any accidental markdown fences the model might add\n  const cleaned = content.replace(/```json|```/g, '').trim();\n  parsed = JSON.parse(cleaned);\n  if (!Array.isArray(parsed)) parsed = [];\n} catch (e) {\n  parsed = [];\n}\n\n// Attach client context and chat_id to every item\nconst clientId = $('Logic: Has Pending Revision?').first().json.client_id;\nconst chatId = $('Logic: Parse Incoming Message').first().json.chat_id;\n\nif (parsed.length === 0) {\n  return [{ json: { items: [], client_id: clientId, chat_id: chatId } }];\n}\n\nreturn [{\n  json: {\n    items: parsed,\n    client_id: clientId,\n    chat_id: chatId\n  }\n}];"
      },
